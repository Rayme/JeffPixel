// JeffPixel deployment configuration, added 2026-10-30. AGPL-3.0-only.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jeffpixel",
  "account_id": "afb11196e629b8de15dc8a05718180d2",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./build",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
